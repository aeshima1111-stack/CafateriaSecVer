<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Cafelicious"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cafeteria"
        tools:targetApi="31">
        <activity
            android:name=".profileActivity"
            android:exported="false" />
        <activity
            android:name=".SignupActivity"
            android:exported="false" />
        <activity
            android:name=".AdminPageActivity"
            android:exported="false" />
        <activity
            android:name=".OrderActivity"
            android:exported="false" />
        <activity
            android:name=".InventoryActivity"
            android:exported="false" />
        <activity
            android:name=".AdminViewActivity"
            android:exported="false" />
        <activity
            android:name=".ViewItemsActivity"
            android:exported="false" />
        <activity
            android:name=".AddDataActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Register AuthActivity and make it the launcher -->
        <activity
            android:name=".AuthActivity"
            android:exported="true" /> <!-- Keep MainActivity registered for future navigation -->
        <activity android:name=".MainActivity" />
        <activity android:name=".HomeActivity" />
        <activity android:name=".MenuActivity" />
        <activity android:name=".BreakfastActivity" />
        <activity android:name=".StartersActivity" />
        <activity android:name=".MainCourseActivity" />
        <activity android:name=".DessertActivity" />
        <activity android:name=".BeveragesActivity" />
        <activity android:name=".CartActivity" />
        <activity android:name=".PaymentActivity" />
        <activity android:name=".OrderConfirmationActivity" />
    </application>

</manifest>